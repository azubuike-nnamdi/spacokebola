#!/usr/bin/env sh

echo "🔍 Running post-merge hook..."

changed_files="$(git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD 2>/dev/null)"

if echo "$changed_files" | grep -Eq 'package\.json|pnpm-lock\.yaml'; then
  echo "📦 Dependencies changed. Running pnpm install..."
  pnpm install
  if [ $? -ne 0 ]; then
    echo "⚠️ pnpm install failed after merge. Please check your dependencies."
    exit 0
  fi
else
  echo "✅ No package.json / pnpm-lock.yaml changes."
fi

echo "✅ Post-merge actions completed."
