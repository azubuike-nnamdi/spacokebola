# Neon Postgres (use the pooled connection string from the Neon dashboard)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"

# Used to encrypt JWT tokens (required)
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public site URL — no trailing slash (required in production)
# Local:
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Vercel example:
# NEXT_PUBLIC_SERVER_URL=https://your-app.vercel.app

# Secret used to authenticate cron jobs
# Generate with: openssl rand -base64 32
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
# Generate with: openssl rand -base64 32
PREVIEW_SECRET=YOUR_SECRET_HERE

# Optional: first admin user created by `pnpm seed`
# SEED_ADMIN_EMAIL=admin@okebola.org
# SEED_ADMIN_PASSWORD=password
# SEED_ADMIN_NAME=Site Admin
